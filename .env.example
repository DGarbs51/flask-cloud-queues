# Copy to .env, then use uv run --env-file .env ... (the app never reads it).
# Leave the explicit backend unset on Cloud: its managed queue config selects it.
LARAVEL_CLOUD_QUEUES_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/1
DEMO_KEY_PREFIX=flask-demo:
DATABASE_URL=mysql://root@127.0.0.1:3306/flask_cloud_queues
PORT=8001
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
# Avoid macOS system-proxy discovery from a forked gunicorn worker's check threads.
NO_PROXY=*
# DB_SSL_VERIFY=0 # Cloud's self-signed database proxy (TLS remains encrypted).
